% -----------------------------
% Script: Designs Baseline Torque Controller.
% Exercise 02 of "Controller Design for Wind Turbines and Wind Farms"
% -----------------------------
clearvars;close all;clc;
addpath(genpath('..\Library\'))

% default parameter turbine 
Parameter       = NREL5MWDefaultParameter_SLOW1DOF;

% local variables
theta           = Parameter.Turbine.SS.theta;
lambda          = Parameter.Turbine.SS.lambda;
c_P             = Parameter.Turbine.SS.c_P;
rho             = Parameter.General.rho;
R               = Parameter.Turbine.R;
r_GB            = Parameter.Turbine.r_GB;
eta_el          = Parameter.Generator.eta_el;

% select design values
lambda_opt      = 7.55;                             % [-]
theta_opt       = 0;                                % [rad]

% determine optimal power coefficient 
c_P             = Parameter.Turbine.SS.c_P;
[cp_max, linearIndex] = max(c_P(:))
[row, col] = ind2sub(size(c_P), linearIndex)
lambda_max = lambda(row)
theta_max = theta(col)
c_P_opt         = interp2(theta,lambda,c_P,theta_opt,lambda_opt);
deltaP_perc = (cp_max-c_P_opt)/c_P_opt*100
deltaP = deltaP_perc/100*5e6
Pmax = cp_max*.5*rho*pi*R^2*8

% Region 2: determine k
k               = 1/2*rho*pi*R^5*c_P_opt/(lambda_opt*r_GB)^3;                              % [Nm/(rad/s)^2]    Please adjust!

% Region 3: determine M_g_rated
P_el_rated      = 5e6;                              % [W]
Omega_g_rated   = rpm2radPs(12.1*97);               % [rad/s]
M_g_rated       = P_el_rated/(eta_el*Omega_g_rated);                              % [Nm]              Please adjust!

% region limits & region parameters based on Jonkman 2009
Omega_g_1To1_5  = rpm2radPs(670);                   % [rad/s]
Omega_g_1_5To2  = rpm2radPs(871);                   % [rad/s]
Omega_g_2To2_5  = rpm2radPs(1150.9);              	% [rad/s]
Omega_g_2_5To3  = Omega_g_rated;                    % [rad/s]

% Region 1_5: M_g = a * Omega_g + b: 
% 1.Eq: 0                   = a * Omega_g_1To1_5 + b 
% 2.Eq: k*Omega_g_1_5To2^2  = a * Omega_g_1_5To2 + b
Coeff1_5 = [Omega_g_1To1_5 1;Omega_g_1_5To2 1];
known1_5 = [0 ; k*Omega_g_1_5To2^2];
x1_5 = Coeff1_5\known1_5;
a_1_5           = x1_5(1);
b_1_5           = x1_5(2);

% Region 2_5: M_g = a * Omega_g + b: 
% 1.Eq: M_g_rated           = a * Omega_g_2_5To3   	+ b 
% 2.Eq: k*Omega_g_2To2_5^2  = a * Omega_g_2To2_5    + b
Coeff2_5 = [Omega_g_rated 1;Omega_g_2To2_5 1];
known2_5 = [M_g_rated;k*Omega_g_2To2_5^2];
x2_5 = Coeff2_5\known2_5;
a_2_5           = x2_5(1);
b_2_5           = x2_5(2);

% Display
fprintf('Parameter.VSC.k                         = %.6g;\n',k);
fprintf('Parameter.VSC.M_g_rated                 = %.6g;\n',M_g_rated);
fprintf('Parameter.VSC.a_1_5                     = %.6g;\n',a_1_5);
fprintf('Parameter.VSC.b_1_5                     = %.6g;\n',b_1_5);
fprintf('Parameter.VSC.a_2_5                     = %.6g;\n',a_2_5);
fprintf('Parameter.VSC.b_2_5                     = %.6g;\n',b_2_5);
